# ============================================================
# ViraClip — .gitignore
# ============================================================

# ----- Python -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
PIPFILE.lock

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ----- Secrets & environment files --------------------------
.env.*
.env.local
.env.*.local
.env.production
.env.staging
.env.broll
*.env
!.env.example

# ----- Node / Frontend --------------------------------------
node_modules/
.npm
.yarn/
.pnp.*
.next/
out/
.nuxt/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Root-level package files (not needed at monorepo root)
/package-lock.json
/package.json

# ----- Docker -----------------------------------------------
# Never commit override files with local paths/ports
docker-compose.override.yml
# Old docker-compose backups
docker-compose.yml.old
docker-compose.*.old

# ----- Media & video artifacts ------------------------------
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.aac
uploads/
output/
exports/
clips/
tmp/
temp/
.cache/

# ----- Logs -------------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*

# ----- Databases --------------------------------------------
*.db
*.sqlite
*.sqlite3

# ----- OS ---------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- IDEs & editors ---------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath
*.sublime-workspace

# ----- Testing & coverage -----------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ----- Mypy / type checking ---------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ----- Misc residues ----------------------------------------
# Files accidentally created from copy-pasting shell commands
/-H
/-c
/-d
/psql
/agente_seguros_ai
/qrr-quantum-relational-reasoner

# Empty HTML stubs
/api_docs.html

# ----- Terraform / infra ------------------------------------
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# ----- ComfyUI runtime --------------------------------------
comfyui/models/
comfyui/output/
comfyui/input/
comfyui/custom_nodes/
