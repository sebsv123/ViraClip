# ViraClip Environment Configuration
# Copy this file to .env and configure based on your needs

# ==============================================
# OFFLINE MODE (ZERO API KEYS REQUIRED) 
# ==============================================
# ViraClip works 100% offline with local processing!
# Uncomment these lines for offline-first setup:
#
# WHISPER_MODEL_SIZE=small  # Local transcription (95% accuracy)
# WHISPER_DEVICE=cpu
# CONTEXTUAL_OVERLAYS_ENABLED=true  # Uses gradient+emoji (no API)
# SPEED_CONTROL_ENABLED=true
# SCENE_DETECTION_ENABLED=true
# AUDIO_DUCKING_ENABLED=true
#
# Leave API keys empty - ViraClip uses smart fallbacks:
# - Transcription: Local Whisper (no API)
# - Virality: Rule-based heuristics (no LLM)
# - Overlays: Gradient generation (no Unsplash/Pexels)
# - Face tracking: MediaPipe (no API)
# 
# See OFFLINE_MODE.md for complete offline guide

# ==============================================
# AI Provider API Keys (Optional - Enhanced Features)
# ==============================================

# HuggingFace token for downloading datasets (e.g., TikTok-Videos from HuggingFace)
# Required for: python scripts/download_datasets.py --tiktok-only
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# AssemblyAI - Required for video transcription with word-level timing
# Whisper device configuration (cpu=safe default, cuda=faster if GPU available)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# For GPU acceleration (requires CUDA properly configured):
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=int8_float16
ASSEMBLY_AI_API_KEY=your_assemblyai_api_key_here

# Choose one AI provider for transcript analysis:
# OpenAI (recommended: gpt-5.2)
OPENAI_API_KEY=

# Google AI (recommended: gemini-3-flash)
GOOGLE_API_KEY=

# Anthropic (claude-3-5-sonnet, claude-4-sonnet)
ANTHROPIC_API_KEY=

# Groq (fast LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Ollama (local/self-hosted or Ollama Cloud)
# Local default: http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional for Ollama Cloud
OLLAMA_API_KEY=

# ==============================================
# Image/Video Generation Providers
# ==============================================

# Pexels - Free stock photos/videos (PRIORITY 1)
# Get your free API key at: https://www.pexels.com/api/
# Free tier: 200 requests/hour
PEXELS_API_KEY=
PEXELS_API_KEY_2=
PEXELS_API_KEY_3=

# Pixabay - Free stock media
# Get your free API key at: https://pixabay.com/api/docs/
# Free tier: 100 requests/minute
PIXABAY_API_KEY=

# Coverr - Free CC0 stock videos (B-roll, no attribution needed)
# Get your free API token at: https://coverr.co/api
COVERR_API_KEY=

# Freesound - Free music + SFX with mood tag search (perfect for B-roll automation)
# Get your free API key at: https://freesound.org/apiv2/apply
# Features: mood:happy/sad/calm, loop, bpm:120, acoustic similarity search
FREESOUND_API_KEY=
FREESOUND_AUTO_MATCH=true   # Auto-match music to B-roll mood
FREESOUND_SFX_ENABLED=true  # Also auto-fetch sound effects

# Google Imagen 3 (PRIORITY 2 - uses same GOOGLE_API_KEY above)
# Free tier: 1000 images/month
# Auto-enabled if GOOGLE_API_KEY is set
USE_GOOGLE_IMAGEN=true

# Replicate - AI image generation + Text-to-Video B-roll (Flux.1, SDXL, CogVideoX)
# Get API token at: https://replicate.com/account/api-tokens
# Cost: ~$0.003/image | ~$0.05/video clip
REPLICATE_API_TOKEN=

# T2V B-roll generation via Replicate (disabled by default, no local GPU needed)
# Models: cogvideox (best) | wan21 (fast) | i2vgen (image-to-video)
T2V_ENABLED=false
T2V_MODEL=cogvideox
T2V_RESOLUTION=720p

# Stability AI - SDXL image generation
# Get API key at: https://platform.stability.ai/account/keys
# Cost: ~$0.002/image
STABILITY_API_KEY=

# Image generation provider order (fallback chain)
# Default: pexels → google_imagen → replicate → stability → dalle
IMAGE_GEN_PROVIDERS=pexels,google_imagen,replicate,stability,dalle

# Apify - Primary YouTube downloader provider
APIFY_API_TOKEN=

# YouTube metadata provider
# `yt_dlp` keeps the current behavior.
# `youtube_data_api` uses the official YouTube Data API first, then falls back to yt-dlp.
YOUTUBE_METADATA_PROVIDER=yt_dlp

# Preferred key for the YouTube Data API metadata path.
# If omitted, metadata requests fall back to GOOGLE_API_KEY when available.
YOUTUBE_DATA_API_KEY=

# ==============================================
# AI Model Configuration
# ==============================================

# Format: "provider:model-name"
# IMPORTANT: You MUST set the corresponding API key above!
# 
# If LLM is not set, the system will auto-detect based on available API keys:
# Priority: Google > OpenAI > Anthropic > Groq > Ollama (local)
#
# Examples:
#   - openai:gpt-5.2 (requires OPENAI_API_KEY) - latest, best reasoning
#   - google-gla:gemini-3-flash-preview (requires GOOGLE_API_KEY) - fast, cost-effective
#   - anthropic:claude-4-sonnet (requires ANTHROPIC_API_KEY)
#   - groq:llama-3.3-70b-versatile (requires GROQ_API_KEY) - fast inference
#   - ollama:llama3.2 (uses local Ollama by default, optional OLLAMA_BASE_URL)
LLM=groq:llama-3.3-70b-versatile

# Whisper model size (tiny, base, small, medium, large)
# Larger models are more accurate but slower
WHISPER_MODEL_SIZE=medium

# Mark stale queued tasks as error after this many seconds
QUEUED_TASK_TIMEOUT_SECONDS=180

# Default target resolution requested from the Apify YouTube downloader
APIFY_YOUTUBE_DEFAULT_QUALITY=1080

# Processing defaults
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=nano

# ==============================================
# Authentication
# ==============================================

# Better Auth secret (change this in production!)
# Generate a secure random string for production
BETTER_AUTH_SECRET=viraclip_dev_secret_change_in_production

# Set to true/1/yes to disable new user sign-ups.
DISABLE_SIGN_UP=false

# Set to true to disable all routes except the landing page.
NEXT_PUBLIC_LANDING_ONLY_MODE=false

# ==============================================
# Analytics (optional)
# ==============================================

# DataFast public website ID (example: dfid_xxxxxx)
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=

# DataFast tracked domain without protocol (example: supoclip.com)
NEXT_PUBLIC_DATAFAST_DOMAIN=

# Set to true only when you want to test DataFast on localhost
NEXT_PUBLIC_DATAFAST_ALLOW_LOCALHOST=false

# Resend API key for waitlist confirmation emails (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL="ViraClip <onboarding@resend.dev>"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# Monetization (optional, disabled by default)
# ==============================================

# Open-source/self-host mode. Monetization is only enabled when SELF_HOST=false
SELF_HOST=true
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
AUTH_SIGNATURE_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:3000,http://sp.localhost:3000

# Hosted mode does not allow free processing. This is reserved for future use.
FREE_PLAN_TASK_LIMIT=10

# Pro plan monthly generation limit (set 0 for unlimited)
PRO_PLAN_TASK_LIMIT=0

# Stripe settings (required only when SELF_HOST=false)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
NEXT_PUBLIC_PRO_PRICE_MONTHLY=9.99
NEXT_PUBLIC_FREE_PLAN_TASK_LIMIT=10
NEXT_PUBLIC_PRO_PLAN_TASK_LIMIT=0

# Optional fallback links when Stripe sessions are not configured
STRIPE_CHECKOUT_URL=
STRIPE_CUSTOMER_PORTAL_URL=

# ==============================================
# Admin dashboard (Feature E)
# ==============================================

# Secret used to sign admin JWT tokens. Set a long random string in production.
# Without this, /admin/login and /admin/stats return 503.
ADMIN_SECRET=change_me_admin_secret

# ==============================================
# Feature Flags (Phase 5)
# All default to false/disabled. Set to true to enable.
# ==============================================

# Enable admin JWT dashboard at /admin/login and /admin/stats
ADMIN_ENABLED=false

# Enable 👍/👎 user feedback endpoints (Feature C)
FEEDBACK_ENABLED=false

# Enable browser + title bar notifications on task completion (Feature B)
NOTIFICATIONS_ENABLED=false

# Enable background music mixing (global on/off for BGM). Recommended: true
BGM_ENABLED=true

# Enable speech ducking for background music (Fix 7). Recommended: true
MUSIC_DUCKING_ENABLED=true

# Enable Smart Auto Editor (viral text pops + jump cuts + speed ramps)
SMART_AUTO_EDITOR_ENABLED=false

# Enable Audio Denoiser (noise reduction + voice isolation after ducking)
AUDIO_DENOISE_ENABLED=false

# Enable EliteAI Trend Intelligence (LLM-based trend analysis — can be noisy)
ELITEAI_TRENDS_ENABLED=false

# LUT color grading style: neutral | warm_cinematic | cool_modern | teal_orange | warm_film
#   neutral       — natural Rec.709, no color cast (default)
#   warm_cinematic — warm orange/rose skin tones, teal shadows, no aggressive yellow
#   cool_modern   — subtle cool tint, clean modern look
LUT_STYLE=neutral

# Enable SFX Orchestrator (sound effects after jump cuts, before BGM)
SFX_ENABLED=false

# SFX profile: none | subtle | modern
#   none    — no sound effects
#   subtle  — quiet, sparse SFX (default)
#   modern  — louder, more frequent SFX for high-energy clips
SFX_PROFILE=subtle

# Enable Brand Overlay (text watermark + image logo as final step before export)
BRAND_OVERLAY_ENABLED=false
# Brand overlay text (e.g. "@viraclip")
BRAND_OVERLAY_TEXT=
# Brand overlay image path (e.g. "/app/assets/logo.png")
BRAND_OVERLAY_IMAGE=
# Brand overlay position: bottom_right, top_left, top_right, bottom_left
BRAND_OVERLAY_POSITION=bottom_right
# Brand overlay horizontal padding in pixels
BRAND_OVERLAY_PADDING_X=20
# Brand overlay vertical padding in pixels
BRAND_OVERLAY_PADDING_Y=20
# Brand overlay font size for text watermark
BRAND_OVERLAY_FONT_SIZE=28
# Brand overlay font color for text watermark
BRAND_OVERLAY_FONT_COLOR=white
# Brand overlay font opacity (0.0–1.0)
BRAND_OVERLAY_FONT_OPACITY=0.85
# Brand overlay image opacity (0.0–1.0)
BRAND_OVERLAY_IMAGE_OPACITY=0.80
# Brand overlay image scale filter (e.g. "80:-1")
BRAND_OVERLAY_IMAGE_SCALE=80:-1

# ==============================================
# Subtitle Re-alignment (Fase 1)
# ==============================================

# Enable re-transcription of clips for precise timestamps
SUBTITLE_REALIGN_ENABLED=true

# Whisper model for re-alignment: tiny|base|small|medium (balance speed/precision)
SUBTITLE_REALIGN_MODEL=small

# Anticipation offset in ms (negative = subtitles appear BEFORE word is spoken)
SUBTITLE_ANTICIPATION_MS=-50

# ==============================================
# Audio Ducking Adaptativo (Dia 3)
# ==============================================

# Ducking mode: predictive (word timestamps) | sidechain (reactive) | off
DUCKING_MODE=predictive

# Volume multiplier during speech (0.45 = music at 45% of base vol = ~10%)
DUCKING_VOICE_RATIO=0.45

# Volume multiplier during long pauses >1s (2.0 = music at 200% of base = ~44%)
DUCKING_LONG_PAUSE_BOOST=2.0

# Volume multiplier during short pauses 0.35-1s
DUCKING_SHORT_PAUSE_BOOST=1.2

# ==============================================
# Voice Enhancement (Dia 4)
# ==============================================

# Enable voice enhancement pipeline (RVC fallback uses FFmpeg professional chain)
VOICE_ENHANCEMENT_ENABLED=true

# Noise gate threshold in dB (lower = more aggressive gating)
VOICE_NOISE_GATE_THRESHOLD=-35

# Vocal presence boost at 3kHz in dB
VOICE_PRESENCE_BOOST=2.5

# Enable Pexels B-Roll overlay on clips (Feature A). Requires PEXELS_API_KEY.
BROLL_ENABLED=false

# ==============================================
# Feedback (optional — posts to Discord)
# ==============================================

# Discord webhook URLs (each posts to a separate channel)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# ==============================================
# Database Configuration
# ==============================================

# PostgreSQL credentials (matches docker-compose.yml)
POSTGRES_DB=viraclip
POSTGRES_USER=viraclip
POSTGRES_PASSWORD=viraclip_password

# Redis password for Docker/local development.
# Leave blank to run Redis without AUTH, or set a value to require authentication.
REDIS_PASSWORD=

# ==============================================
# Docker Performance
# ==============================================

# Enable BuildKit for faster Docker builds
COMPOSE_DOCKER_CLI_BUILD=1

# ==============================================
# Phase 13 — Social Publishing (optional)
# ==============================================

# TikTok Content Posting API v2
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# YouTube Data API v3
YOUTUBE_ACCESS_TOKEN=

# Public CDN base URL for Instagram video uploads (e.g. https://cdn.yourdomain.com)
VIRACLIP_CDN_URL=

# ElevenLabs API keys for AI voiceover (falls back to OpenAI TTS if unset)
# ELEVENLABS_API_KEY_2 is used as fallback if ELEVENLABS_API_KEY returns 429/401
ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY_2=

# File paths for persistent JSON stores (defaults shown)
PERF_STORE_PATH=/app/data/performance_events.json
NICHE_WEIGHTS_PATH=/app/data/niche_weights.json

# ==============================================
# Phase 14 — Automation & Ingestion (optional)
# ==============================================

# Directory where yt-dlp downloads are saved
INGEST_OUTPUT_DIR=/app/storage/ingested

# File path for autopilot workflow store
AUTOPILOT_STORE_PATH=/app/data/autopilot_workflows.json

# ==============================================
# Audio Library Expansion
# ==============================================

# Auto-download audio library on first run
AUTO_DOWNLOAD_AUDIO=true

# Audio sources to download from (comma-separated)
# Options: pixabay, mixkit, incompetech
AUDIO_SOURCES=pixabay,mixkit

# Target number of files to download
TARGET_BGM_COUNT=50
TARGET_SFX_COUNT=50

# Audio library path (default: /app/assets/sounds)
AUDIO_LIBRARY_PATH=/app/assets/sounds

# ==============================================
# Structured Reasoning System (Optional)
# ==============================================

# Reasoning mode for LLM analysis
# Options: "monolithic" (default, single prompt), "structured" (5-step COT)
REASONING_MODE=monolithic

# Log each reasoning step (verbose debugging)
REASONING_STEPS_LOGGING=false

# Save reasoning traces to disk for review
SAVE_REASONING_TRACES=false

# Directory for reasoning trace files
REASONING_TRACE_DIR=/app/data/reasoning_traces

DOCKER_BUILDKIT=1

# ==============================================
# ComfyUI Integration
# ==============================================

# Enable ComfyUI integration for AI-powered video generation
COMFYUI_ENABLED=true

# ComfyUI server URL (change if running on different host/port)
COMFYUI_URL=http://localhost:8188

# SDXL model for thumbnail generation
COMFYUI_SDXL_MODEL=sd_xl_turbo_1.0_fp16.safetensors

# LTX-Video model for B-roll generation
COMFYUI_LTX_MODEL=ltx-video-2b-v0.9.5.safetensors

# ==============================================
# B-roll Generation
# ==============================================

# Enable LTX-Video for AI B-roll generation (requires ComfyUI)
BROLL_USE_LTX=true

# B-roll provider mode: hybrid | generative | stock_only
#   hybrid (default) — try ComfyUI/LTX first, fallback to stock APIs on failure
#   generative       — try ComfyUI/LTX only, fallback to stock on failure/timeout
#   stock_only       — skip ComfyUI/LTX entirely, use stock APIs only
BROLL_MODE=hybrid

# Timeout in seconds for ComfyUI B-roll generation (default: 10)
BROLL_COMFYUI_TIMEOUT=10

# ==============================================
# Background Composite (SAM2 + LTX-Video)
# ==============================================
# Updated: 2026-04-23

# Enable AI background removal + LTX composite (requires SAM2 in ComfyUI)
# Set to true only after installing ComfyUI-segment-anything-2 custom node
BACKGROUND_COMPOSITE_ENABLED=false

# Enable SAM2 specifically (can be disabled independently)
SAM2_ENABLED=false

# ComfyUI host for background generation (default: http://localhost:8188)
COMFYUI_HOST=http://localhost:8188

# Path to SAM2+LTX Video workflow JSON file
COMFYUI_WORKFLOW_SAM2=~/ComfyUI/workflows/sam2_ltxvideo.json

# Timeout for ComfyUI render operations (seconds)
COMFYUI_TIMEOUT=120

# SAM2 model filename (must be in ~/ComfyUI/models/sam2/)
SAM2_MODEL=sam2_hiera_small.pt

# Minimum viral score to attempt Mode A composite (0.0-10.0)
SAM2_MIN_VIRAL_SCORE=7.5

# Minimum clip duration in seconds for Mode A
SAM2_MIN_DURATION=12.0

# Docker volume paths for ComfyUI integration
COMFYUI_INPUT_DIR=/comfyui/input
COMFYUI_OUTPUT_DIR=/comfyui/output

# ==============================================
# Email Notifications (Resend)
# ==============================================

# Set to true and configure RESEND_API_KEY to enable email notifications
RESEND_ENABLED=false

# Resend API key for sending transactional emails
RESEND_API_KEY=

# From email address for Resend (must be verified in Resend dashboard)
RESEND_FROM_EMAIL="ViraClip <onboarding@resend.dev>"
