+            score += 30
+            reasons.append("category_topic_match:+30")
+
+    # Intent-specific boosts
+    if intent_type == "family_responsibility" and any(
+        term in phrase_lower for term in ("family", "parents", "child", "home", "couple", "protection")
+    ):
