+def _is_task_scoped_output(path: Path, task_id: str) -> bool:
+    if not path:
+        return False
+    path_str = str(path)
+    task_id_clean = (task_id or "").strip()
+    if not task_id_clean:
+        return False
+    if f"/{task_id_clean}/" in path_str:
+        return True
+    if task_id_clean in path.name:
+        return True
+    return False
