+                if temporal_overlap_ratio <= 0.65:
+                    continue
+                jaccard, coverage = _text_overlap_metrics(str(a.get("text") or ""), str(b.get("text") or ""))
+                text_overlap = max(jaccard, coverage)
+                if text_overlap < 0.50:
