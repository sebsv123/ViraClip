+            clip_angle,
+            campaign_intent_n,
+            editorial_score_f,
+            hookability_score_f,
+            commercial_usefulness_score_f,
+            standalone_score_f,
+            boundary_confidence_f,
+            campaign_alignment_score_f,
+        )
+    if clip_review_flags:
