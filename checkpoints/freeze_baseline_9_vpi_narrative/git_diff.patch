+    for mod in optional:
+        try:
+            importlib.import_module(mod)
+        except Exception:
+            missing_optional.append(mod)
+    return {
+        "python_executable": sys.executable,
+        "missing_required": missing_required,
+        "missing_optional": missing_optional,
+    }
+
+
