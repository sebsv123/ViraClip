+        if mood == "cinematic_ambient":
+            continue  # fallback only
+        if key in cfg["editorial_types"]:
+            scores[mood] = 1.0
+        elif key in cfg["forbidden_editorial_types"]:
+            scores[mood] = -1.0  # penalise
+        else:
+            scores[mood] = 0.0
+    return sorted(scores.items(), key=lambda x: -x[1])
