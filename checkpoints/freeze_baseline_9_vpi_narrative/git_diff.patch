+TASK_DIAGNOSTIC_CHOKEPOINTS = {
+    "source_download",
+    "transcription",
+    "segment_selection",
+    "extraction",
+    "render",
+    "technical_qc",
+    "editorial_qc",
+    "publishable_gate",
+    "db_insert",
+    "frontend_visibility",
+    "delivered",
+    "unknown",
+}
