+    @staticmethod
+    def _seconds_to_ass_time(seconds: float) -> str:
+        """Convierte segundos a formato de tiempo ASS (H:MM:SS.cc)."""
+        h = int(seconds // 3600)
+        m = int((seconds % 3600) // 60)
+        s = int(seconds % 60)
+        cs = int((seconds % 1) * 100)
+        return f"{h}:{m:02d}:{s:02d}.{cs:02d}"
