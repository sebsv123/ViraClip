# ============================================================================
# ViraClip Backend — Environment Configuration
# ============================================================================
# Copy this file to .env and adjust values for your environment.
#
# Environment profiles:
#   LOCAL DEV:   All new integrations OFF (stable defaults)
#   STAGING:     Enable new modules one by one for testing
#   PRODUCTION:  Gradual rollout — enable only validated modules
# ============================================================================

# ── Core LLM Providers ──────────────────────────────────────────────────────
# At least one is required for best quality. Groq is recommended for speed.
OPENAI_API_KEY=
GOOGLE_API_KEY=
YOUTUBE_DATA_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# The AI Model to use throughout the app
LLM=google-gla:gemini-3-flash-preview

# ── Whisper (Speech-to-Text) ────────────────────────────────────────────────
# large-v3 gives ~40% better WER and more accurate word timestamps
WHISPER_MODEL_SIZE=large-v3

# ── AssemblyAI (Alternative STT + Confidence-based subtitles) ───────────────
ASSEMBLY_AI_API_KEY=

# ── Task Queue ──────────────────────────────────────────────────────────────
# Prevent tasks from sitting in queued forever if worker is down
QUEUED_TASK_TIMEOUT_SECONDS=180

# ── YouTube Metadata ────────────────────────────────────────────────────────
# Provider: `yt_dlp` or `youtube_data_api`
YOUTUBE_METADATA_PROVIDER=yt_dlp

# ── Processing Defaults ─────────────────────────────────────────────────────
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=nano

# ── Docker Build ────────────────────────────────────────────────────────────
COMPOSE_BAKE=true

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=viraclip
POSTGRES_USER=viraclip
POSTGRES_PASSWORD=viraclip_password

# ── Media APIs ──────────────────────────────────────────────────────────────
PIXABAY_API_KEY=                          # Royalty-free background music
PEXELS_API_KEY=                           # B-Roll stock video
COVERR_API_KEY=                           # Stock video (alternative)
FREESOUND_API_KEY=                        # SFX library (freesound.org)
UNSPLASH_ACCESS_KEY=                      # Stock photos for overlays
REPLICATE_API_TOKEN=                      # AI image/video generation

# ── Audio Processing ────────────────────────────────────────────────────────
DENOISE_NOISE_FLOOR_DB=-25                # Audio denoising threshold
SILENCE_THRESHOLD_SECONDS=0.4             # Silence removal gap

# ── B-Roll ──────────────────────────────────────────────────────────────────
BROLL_ENABLED=false                       # Master B-roll switch
YOLO_BROLL_ENABLED=false                  # YOLOv10 object detection for B-roll

# ── GPU Worker (Phase 5.2) ──────────────────────────────────────────────────
GPU_WORKER_ENABLED=false                  # Enable with --profile gpu
T2V_MODEL=ltx-video                       # ltx-video | wan2.2-1.3b | wan2.2-14b
T2V_RESOLUTION=720p                       # 480p | 720p | 1080p
UPSCALING_MODEL=realesrgan                # realesrgan | esrgan
TTS_MODEL=xtts-v2                         # xtts-v2 | tortoise
ONNX_MODEL_DIR=/app/models/onnx

# ── Hook Slow-Motion (Phase 3.5) ────────────────────────────────────────────
HOOK_SLOWMO_ENABLED=false
HOOK_SLOWMO_DURATION=1.5
HOOK_SLOWMO_SPEED=0.5
HOOK_SLOWMO_MIN_SCORE=70

# ── SFX Library (Phase 2.5) ─────────────────────────────────────────────────
SFX_LIBRARY_PATH=/app/assets/sfx_library
CLAP_ENABLED=true                         # Semantic SFX matching (requires msclap)

# ── Contextual Overlays ─────────────────────────────────────────────────────
CONTEXTUAL_OVERLAYS_ENABLED=true
MAX_OVERLAYS_PER_CLIP=8
OVERLAY_MIN_VIRALITY=60.0
AI_OVERLAY_ENABLED=false                  # Requires GPU worker
OVERLAY_CACHE_DIR=/app/storage/overlay_cache

# ── Speed Control & Scene Detection ─────────────────────────────────────────
SPEED_CONTROL_ENABLED=true
SCENE_DETECTION_ENABLED=true

# ── SAM2 Object Tracking ────────────────────────────────────────────────────
SAM2_ENABLED=false
TRACKING_MODE=auto
SAM2_MODELS_DIR=/app/models/sam2

# ── Admin Dashboard ─────────────────────────────────────────────────────────
ADMIN_SECRET=change_me_admin_secret
ADMIN_ENABLED=false

# ── Discord Webhooks ────────────────────────────────────────────────────────
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# ── ComfyUI Integration (Phase 6-7) ─────────────────────────────────────────
COMFYUI_ENABLED=false
# Set to true only if you have a ComfyUI server running with LTX-Video.
# Not needed for insurance/Spanish talking-head clips.
COMFYUI_HOST=comfyui
COMFYUI_PORT=8188
COMFYUI_TIMEOUT=300

# ── HuggingFace & Kaggle ────────────────────────────────────────────────────
HF_TOKEN=
HUGGINGFACE_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
YOUTUBE_API_KEY=
VIRACLIP_DATASETS_DIR=/app/datasets

# ── LoRA Training (Phase 6.4) ───────────────────────────────────────────────
LORA_TRAINING_ENABLED=false
LORA_BASE_MODEL=wan2.2-1.3b
LORA_EPOCHS=10
LORA_LEARNING_RATE=1e-4

# ── Viral Trends (Phase 4.3) ────────────────────────────────────────────────
VIRAL_TRENDS_ENABLED=true
TRENDING_REFRESH_INTERVAL_HOURS=1

# ── Milvus Vector DB (Phase 5.1) ────────────────────────────────────────────
MILVUS_ENABLED=true
MILVUS_DATA_DIR=/app/milvus_data

# ── Monetization ────────────────────────────────────────────────────────────
SELF_HOST=true
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
AUTH_SIGNATURE_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:3000,http://sp.localhost:3000
FREE_PLAN_TASK_LIMIT=10
PRO_PLAN_TASK_LIMIT=0

# ============================================================================
# FEATURE FLAGS — Integration Module Toggles
# ============================================================================
# All new integrations are OFF by default (opt-in via env).
# Recommended values per environment:
#   LOCAL DEV:   Keep all OFF for fastest iteration
#   STAGING:     Enable modules one at a time for validation
#   PRODUCTION:  Enable only after staging validation
#
# To enable a flag, set it to "true" or "1".
# ============================================================================

# ── AI B-Roll Recommender ───────────────────────────────────────────────────
# LLM-powered B-roll keyword extraction from transcript segments.
# Fallback: uses simple TF-IDF keyword extraction (no LLM call).
# Recommended: LOCAL=false  STAGING=true  PRODUCTION=after validation
AI_BROLL_ENABLED=false

# ── Short Video Maker Pexels Integration ────────────────────────────────────
# Port of short-video-maker's Pexels client for B-roll fetching.
# Fallback: uses the existing PexelsService (pexels_client.py) directly.
# Recommended: LOCAL=false  STAGING=true  PRODUCTION=after validation
SHORT_VIDEO_MAKER_PEXELS_ENABLED=false

# ── Background Music Service ────────────────────────────────────────────────
# Mood-based background music selection from local library.
# Fallback: no background music (pipeline continues silently).
# Recommended: LOCAL=false  STAGING=true  PRODUCTION=after validation
BACKGROUND_MUSIC_ENABLED=false

# ── AI Clips Maker ──────────────────────────────────────────────────────────
# External AI-driven clip segmentation (ai-clips-maker integration).
# Fallback: uses internal viral_gate segmentation only.
#   - No external scene boundary adjustment.
#   - Segments are purely based on internal transcript analysis.
# Recommended: LOCAL=false  STAGING=validate  PRODUCTION=after validation
AI_CLIPS_MAKER_ENABLED=false

# ── ClipsAI Integration ─────────────────────────────────────────────────────
# Third-party ClipsAI service for automated clip generation.
# Fallback: skips ClipsAI, uses native pipeline only.
# Recommended: LOCAL=false  STAGING=validate  PRODUCTION=after validation
CLIPSAI_ENABLED=false

# ── Shorts Highlight Engine ─────────────────────────────────────────────────
# LLM-based highlight detection + OpenCV face-aware vertical crop.
# Fallback: uses existing segment boundaries (no highlight re-ranking).
# Recommended: LOCAL=false  STAGING=true  PRODUCTION=after validation
SHORTS_ENGINE_ENABLED=false
SHORTS_ENGINE_PROVIDER=samuraigpt

# ── Editlist Backend ────────────────────────────────────────────────────────
# Declarative editlist pipeline (gradual rollout: cuts → overlays → transitions).
# Fallback: builds FFmpeg commands directly (legacy approach).
# Master switch (ON by default for backward compatibility):
EDITLIST_ENABLED=true
# Phase 1: cuts/concat only (ON by default)
EDITLIST_ENABLE_CUTS=true
# Phase 2: + overlays (OFF by default — opt-in)
EDITLIST_ENABLE_OVERLAYS=false
# Phase 3: + transitions (OFF by default — opt-in)
EDITLIST_ENABLE_TRANSITIONS=false

# ── Face Auto-Crop ──────────────────────────────────────────────────────────
# Intelligent face-tracking auto-crop to 9:16 using OpenCV Haar cascades.
# When enabled, takes priority over ImpactZoomService and zoom_punch
# to avoid conflicting crop trajectories.
# Fallback: fixed center crop (no face tracking). ImpactZoom/zoom_punch behave as before.
# Recommended: LOCAL=true  STAGING=true  PRODUCTION=true
FACE_AUTOCROP_ENABLED=true

# ── Faceless Feature ────────────────────────────────────────────────────────
# Automated faceless video generation (text-to-video + TTS narration).
# Fallback: requires source video input (no auto-generation).
# Recommended: LOCAL=false  STAGING=validate  PRODUCTION=after validation
FACELESS_FEATURE_ENABLED=false

# ── Caption Backend Selector ────────────────────────────────────────────────
# "legacy" = original subtitle rendering (drawtext filter) — stable default
# "auto_subtitle" = new auto-subtitle service (AssemblyAI + confidence-based)
# Fallback: "legacy" — original drawtext-based subtitle rendering
# Recommended: LOCAL=legacy  STAGING=auto_subtitle  PRODUCTION=legacy (until validated)
CAPTION_BACKEND=legacy

# ── Export Preset ───────────────────────────────────────────────────────────
# "tiktok_basic"    = 9:16, 30fps, AAC 128k (default, most compatible)
# "fast_vertical"   = 9:16, 24fps, AAC 96k (faster encode, lower quality)
# "youtube_shorts"  = 9:16, 30fps, AAC 192k (higher audio quality)
# "instagram_reels" = 9:16, 30fps, AAC 128k + interlace
# Fallback: "tiktok_basic"
EXPORT_PRESET=tiktok_basic

# ── Optimization Loop ───────────────────────────────────────────────────────
# Clip performance analysis + creative hints feedback loop.
# Fallback: no performance-driven optimization.
# Recommended: LOCAL=false  STAGING=true  PRODUCTION=after validation
OPTIMIZATION_LOOP_ENABLED=false
OPTIMIZATION_LOOP_WORKSPACE_ID=default
OPTIMIZATION_LOOP_MIN_SAMPLES=10
OPTIMIZATION_LOOP_MIN_DELTA=0.05
