# The model size of OpenAI Whisper (see https://github.com/openai/whisper#available-models-and-languages)
# large-v3 gives ~40% better WER and more accurate word timestamps (recommended for production)
WHISPER_MODEL_SIZE=large-v3

# LLM Providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
YOUTUBE_DATA_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# The AI Model to use throughout the app
LLM=google-gla:gemini-3-flash-preview

# Prevent tasks from sitting in queued forever if worker is down
QUEUED_TASK_TIMEOUT_SECONDS=180

# YouTube metadata lookup provider: `yt_dlp` or `youtube_data_api`
YOUTUBE_METADATA_PROVIDER=yt_dlp

# Processing defaults
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=nano

# Good for speed optimizations
COMPOSE_BAKE=true

# DB
POSTGRES_DB=viraclip
POSTGRES_USER=viraclip
POSTGRES_PASSWORD=viraclip_password

ASSEMBLY_AI_API_KEY=

# Pixabay API key for royalty-free background music auto-fetch
PIXABAY_API_KEY=

# B-Roll from Pexels (set BROLL_ENABLED=true to activate)
PEXELS_API_KEY=
BROLL_ENABLED=false

# Audio denoising noise floor in dB (default -25, lower = more aggressive)
DENOISE_NOISE_FLOOR_DB=-25

# Silence removal threshold in seconds (gaps longer than this are cut)
SILENCE_THRESHOLD_SECONDS=0.4

# YOLOv10 object detection for contextual B-Roll (downloads ~6MB model on first use)
YOLO_BROLL_ENABLED=false

# ============================================================================
# Phase 5.2: GPU Worker Tier
# Enable with: docker-compose --profile gpu up -d
# ============================================================================

# Set true when running with --profile gpu (auto-set inside gpu_worker container)
GPU_WORKER_ENABLED=false

# Text-to-Video B-Roll generation model (requires GPU worker)
# Options: ltx-video | wan2.2-1.3b | wan2.2-14b
T2V_MODEL=ltx-video
T2V_RESOLUTION=720p      # 480p | 720p | 1080p

# Video upscaling model (requires GPU worker)
# Options: realesrgan | esrgan
UPSCALING_MODEL=realesrgan

# TTS narration model (requires GPU worker)
# Options: xtts-v2 | tortoise
TTS_MODEL=xtts-v2

# ONNX model directory for mobile/edge inference (Phase 8.4)
ONNX_MODEL_DIR=/app/models/onnx

# Hook slow-motion effect (Phase 3.5)
# Apply slow-mo to the first N seconds of high-virality clips (CPU via FFmpeg minterpolate)
HOOK_SLOWMO_ENABLED=false
HOOK_SLOWMO_DURATION=1.5
HOOK_SLOWMO_SPEED=0.5
HOOK_SLOWMO_MIN_SCORE=70

# ============================================================================
# Phase 2.5: Freesound.org + CLAP SFX Library
# ============================================================================

# Freesound API key for downloading CC0 SFX (get free at freesound.org/apiv2/apply/)
# Leave empty to use fallback downloads (no account needed)
FREESOUND_API_KEY=

# Local path for SFX library (CC0 sounds + CLAP embeddings cache)
# Docker: /app/assets/sfx_library | Local dev: ./backend/assets/sfx_library
SFX_LIBRARY_PATH=/app/assets/sfx_library

# CLAP model for semantic SFX matching (requires msclap)
# Set false to use filename-based fallback (faster, no 900MB model)
CLAP_ENABLED=true

# Admin dashboard
ADMIN_SECRET=change_me_admin_secret
ADMIN_ENABLED=false

# Discord webhook URLs (each posts to a separate channel)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# ============================================================================
# Phase 6-7: ComfyUI Integration & Datasets
# ============================================================================

# ComfyUI Service
COMFYUI_ENABLED=true
COMFYUI_HOST=comfyui
COMFYUI_PORT=8188
COMFYUI_TIMEOUT=300

# HuggingFace Token (para TikTok-Videos dataset y modelos)
# Obtén en: https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGINGFACE_TOKEN=

# Kaggle API Credentials (para Short Video Engagement dataset)
# Obtén en: https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# YouTube Data API v3 (para YouTube Trending data - opcional)
YOUTUBE_API_KEY=

# Datasets directory (donde se guardan datasets descargados)
VIRACLIP_DATASETS_DIR=/app/datasets

# LoRA Training (GPU required - Phase 6.4)
LORA_TRAINING_ENABLED=false
LORA_BASE_MODEL=wan2.2-1.3b
LORA_EPOCHS=10
LORA_LEARNING_RATE=1e-4

# Phase 4.3: Viral Trend Integration
VIRAL_TRENDS_ENABLED=true
TRENDING_REFRESH_INTERVAL_HOURS=1

# Phase 5.1: Milvus Vector DB
MILVUS_ENABLED=true
MILVUS_DATA_DIR=/app/milvus_data

# Monetization (only enabled when SELF_HOST=false)
SELF_HOST=true
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
AUTH_SIGNATURE_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:3000,http://sp.localhost:3000
# Hosted mode currently requires paid subscription to process tasks.
FREE_PLAN_TASK_LIMIT=10
PRO_PLAN_TASK_LIMIT=0
