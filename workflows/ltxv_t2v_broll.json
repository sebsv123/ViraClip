{
  "1": {
    "inputs": {
      "ckpt_name": "ltxv-2b-0.9.8-distilled-fp8.safetensors"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load LTX-Video Model" }
  },
  "2": {
    "inputs": {
      "text": "__POSITIVE_PROMPT__",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "inputs": {
      "text": "low quality, blurry, distorted, watermark, text overlay, ugly, deformed, noisy, overexposed",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "inputs": {
      "width": 480,
      "height": 848,
      "length": 73,
      "batch_size": 1
    },
    "class_type": "EmptyLTXVLatentVideo",
    "_meta": { "title": "Empty Latent (3s @ 24fps + 1)" }
  },
  "5": {
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "LTXV Sampler" }
  },
  "6": {
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "7": {
    "inputs": {
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "ltxv_broll/broll",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": false,
      "pingpong": false,
      "save_output": true,
      "images": ["6", 0]
    },
    "class_type": "VHS_VideoCombine",
    "_meta": { "title": "Save B-Roll Video" }
  }
