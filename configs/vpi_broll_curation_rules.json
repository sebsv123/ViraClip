{
  "curation_rules": {
    "accept_preferred": {
      "duration_range_s": [4.0, 20.0],
      "orientation": ["portrait", "square"],
      "min_resolution": [720, 720],
      "description": "Videos within ideal duration, portrait/square orientation, good resolution"
    },
    "accept_with_caution": {
      "duration_range_s": [3.0, 4.0],
      "orientation": ["landscape"],
      "min_resolution": [640, 640],
      "description": "Short videos or landscape orientation - review carefully for crop-friendliness"
    },
